# ==============================================================================
# Jarvis - Vercel Deployment Ignore Rules (.vercelignore)
# ==============================================================================
# NOTE: .vercelignore applies to the deployment upload for Git-based
# deployments too (Vercel clones the repo, then applies these exclusions) —
# anything listed here is NOT in the deployment. In particular, do NOT
# exclude backend/app/: api/index.py imports it (from app.main import app),
# so excluding it makes every /api/* invocation fail with
# ModuleNotFoundError. Secrets and private data must never be committed
# to source control; this file only trims files the deployment does not need.
# ==============================================================================

# 1. Environment & Configuration Files (exclude all .env variants)
.env
.env.*
*.env
*.env.*
# Retain placeholder example for documentation only
!.env.example

# 2. Private Keys, Certificates & Credential Files
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.crt
*.cer
*.der
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*credentials*.json
client_secret*.json
service-account*.json
token.json
tokens.json

# 3. Python Virtual Environments & Caches
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so

# 4. Backend Local Server Configurations (NOT the app code itself)
# backend/app/ is the Vercel serverless function code (api/index.py imports
# it) and must be deployed. Only the local-only scripts, the duplicate
# requirements file (api/requirements.txt is what Vercel installs), and
# test config are excluded.
backend/scripts/
backend/requirements.txt
pytest.ini
.pytest_cache/
.coverage
htmlcov/

# 5. Automated Tests
backend/tests/

# 6. Local User Data, Private Stores & Audit Logs
data/
notes/
workspace/
screenshots/
backups/
logs/
*.jsonl
*.sqlite
*.sqlite3
*.db

# 7. Local Chrome Browser Extension
# The extension runs unpacked locally in Google Chrome (chrome://extensions).
frontend/extension/

# 8. Git, OS & IDE Artifacts
.git/
.gitignore
.vscode/
.idea/
.DS_Store
Thumbs.db
