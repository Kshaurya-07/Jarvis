# Jarvis Backend Configuration

# Gemini API keys are per-user (BYOK) — see note below.
# Users get their own free key from Google AI Studio: https://aistudio.google.com/
# NOTE (Phase 12, BYOK): there is NO server/owner Gemini key anymore.
# Each user adds their OWN free key in the app (Settings). GEMINI_API_KEY is ignored.
# GEMINI_API_KEY=

# Assistant / Server Settings (Binds strictly to localhost in local mode)

# --- Cloud mode (Vercel production) ---
# Set these as Environment Variables in the Vercel dashboard, never in a committed file.
CLOUD_MODE=false
# Long random secret (32+ chars) signing session JWTs; also the fallback source for the BYOK encryption key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
# Optional dedicated Fernet key for encrypting stored Gemini keys.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, one is derived from SESSION_SECRET.
KEY_ENCRYPTION_KEY=
# Postgres connection string (Neon — see README). REQUIRED in production: Vercel serverless has no persistent filesystem.
DATABASE_URL=
# Public frontend origin users return to after Google sign-in.
FRONTEND_URL=https://jarvis-kumar-shaurya.vercel.app
# Google sign-in (login) redirect URI — must match Google Cloud Console exactly.
# Production: https://<your-vercel-domain>/api/auth/login/callback
GOOGLE_LOGIN_REDIRECT_URI=http://127.0.0.1:8000/api/auth/login/callback
# Per-user Gemini usage caps (fat-finger guards; each user pays with their own key).
GEMINI_CALLS_PER_USER_PER_HOUR=30
GEMINI_CALLS_PER_USER_PER_DAY=100
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Gemini Model Settings
GEMINI_MODEL=gemini-2.5-flash

# Storage Paths (Relative to project root or absolute paths)
WORKSPACE_DIR=./workspace
NOTES_DIR=./notes
SCREENSHOTS_DIR=./screenshots
DATA_DIR=./data
BACKUPS_DIR=./backups
ACTION_LOG_FILE=./logs/actions.jsonl
REMINDERS_FILE=./data/reminders.json
MEMORIES_FILE=./data/memories.json

# Feature Flags
MEMORY_ENABLED=true
ALLOW_REMOTE_ACCESS=false  # Keep false: local mode never listens on a public interface

# Search Provider Configuration (Phase 5)
# Supported providers: tavily, google_custom_search, brave
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your_search_api_key_here
SEARCH_ENGINE_ID=your_google_custom_search_cx_here  # Required only for google_custom_search
SEARCH_TIMEOUT_SECONDS=8.0
MAX_SEARCH_RESULTS=5

# Security Limits & Rate Limiting (Phase 9 Hardening)
MAX_FILE_READ_BYTES=1048576    # 1 MB max file read
MAX_REQUEST_LENGTH=4096        # Max characters for a single user prompt
MAX_REQUEST_BODY_BYTES=2097152 # 2 MB max request body payload
MAX_PAGE_TEXT_CHARS=50000      # 50,000 max characters from browser page
MAX_SEARCH_QUERY_LENGTH=200    # Max search query character length
AUTH_FAILURE_RATE_LIMIT=5      # Max consecutive auth failures before temporary 429
AUTH_FAILURE_WINDOW_SECONDS=60 # Rolling rate limit window in seconds
CONFIRMATION_TIMEOUT_SECONDS=300 # 5 minutes validity for pending confirmations

# Google OAuth 2.0 Credentials (Phase 6 - Read-Only Gmail & Google Calendar)
# Obtain from Google Cloud Console > APIs & Services > Credentials
# Never put real secrets in this example file or commit them to source control.
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_CREDENTIAL_FALLBACK_OPT_IN=false
GOOGLE_FALLBACK_TOKEN_FILE=./data/protected_google_token.json
# List fields must be JSON arrays (pydantic-settings parses them as JSON).
GOOGLE_OAUTH_SCOPES=["https://www.googleapis.com/auth/gmail.readonly","https://www.googleapis.com/auth/calendar.readonly"]
MAX_GMAIL_RESULTS=10
MAX_CALENDAR_RESULTS=25

# Remote Pairing & Tailscale Private Connection (Phase 11)
# ALLOWED_ORIGINS is a JSON array of extra origins permitted in addition
# to the verified Vercel production/preview origins. Leave as [] unless
# you know you need another origin.
ALLOWED_ORIGINS=[]
# Optional explicit Tailscale machine domain, e.g. laptop.tailnet.ts.net
TAILSCALE_HOST=
REMOTE_PAIRING_CODE_TIMEOUT_SECONDS=300 # 5 minutes for short-lived pairing code
REMOTE_SESSION_TIMEOUT_SECONDS=3600     # 1 hour for in-memory session token
PAIRING_RATE_LIMIT=5                    # Max failed pairing attempts
PAIRING_RATE_LIMIT_WINDOW_SECONDS=60    # 60s window for pairing rate limit

